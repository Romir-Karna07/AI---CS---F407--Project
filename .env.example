# Copy to .env (which is git-ignored) and fill in. NEVER commit real keys.
GROQ_API_KEY=                      # language model used by the AI layer (free tier: https://console.groq.com)
# AGRI_LLM_MODEL=openai/gpt-oss-120b   # default. The free tier has a DAILY token quota per model; openai/gpt-oss-20b has its own.
# AGRI_LLM_REASONING=low               # reasoning effort for gpt-oss models (low keeps token use down)
# AGRI_AI=0                            # 0 = switch the AI layer off (rule-based behaviour); same as: python run.py --no-ai
# AGRI_LLM_MAX_CALLS=16                # model-call budget per file
#
# LangSmith: visual traces of every run (graph path, each model call, sub-steps). Free account: https://smith.langchain.com
# NOTE: prompts contain excerpts of your files, so they are uploaded to LangSmith when this is on.
# LANGSMITH_TRACING=true

# LANGSMITH_PROJECT=AI-Project-Manipur
